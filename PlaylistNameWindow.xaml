<Window x:Class="OakMusic.PlaylistNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        Height="285"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="#151515"
            BorderBrush="#282828"
            BorderThickness="1"
            CornerRadius="14">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WindowTitle"
                       Grid.Row="0"
                       Text="Create Playlist"
                       Foreground="#F0F0F0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,14">

                <Border Width="58"
                        Height="58"
                        CornerRadius="8"
                        Background="#252525"
                        ClipToBounds="True">

                    <Image x:Name="PlaylistIconPreview"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <Button Content="Choose Icon"
                            Width="110"
                            Height="34"
                            Background="#252525"
                            Foreground="#E8E8E8"
                            BorderThickness="0"
                            Click="ChooseIconButton_Click"/>

                    <Button x:Name="RemoveIconButton"
                            Content="Remove Icon"
                            Width="110"
                            Height="28"
                            Margin="0,5,0,0"
                            Background="Transparent"
                            Foreground="#888888"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="RemoveIconButton_Click"/>

                </StackPanel>

            </StackPanel>

            <TextBox Grid.Row="2"
                     x:Name="PlaylistNameTextBox"
                     Height="38"
                     Background="#202020"
                     Foreground="#F0F0F0"
                     BorderBrush="#303030"
                     BorderThickness="1"
                     Padding="10"
                     FontSize="13"
                     VerticalContentAlignment="Center"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">

                <Button Content="Cancel"
                        Width="80"
                        Height="34"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        Foreground="#999999"
                        BorderThickness="0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Content="Create"
                        Width="80"
                        Height="34"
                        Background="#303030"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Click="CreateButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>