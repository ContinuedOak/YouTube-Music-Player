<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="#181818"/>

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#202020"/>

    <SolidColorBrush x:Key="SurfaceHoverBrush"
                     Color="#282828"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="#EBEBEB"/>

    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="#B8B8B8"/>

    <SolidColorBrush x:Key="TextMutedBrush"
                     Color="#808080"/>

    <SolidColorBrush x:Key="TextLabelBrush"
                     Color="#707070"/>

    <SolidColorBrush x:Key="BorderBrush"
                     Color="#303030"/>
</ResourceDictionary>