<UserControl x:Class="OakMusic.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OakMusic">

    <Grid Margin="24,8,24,0">

        <StackPanel>

            <TextBlock Text="{Binding Source={x:Static local:AppInfo.Version}, StringFormat=v{0}}"
                       Foreground="{DynamicResource LabelTextBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Border Width="220"
                    Height="220"
                    CornerRadius="14"
                    Background="{DynamicResource AlbumBackgroundBrush}"
                    HorizontalAlignment="Center">

                <Image x:Name="AlbumCover"
                       Stretch="UniformToFill"/>
            </Border>

            <TextBlock x:Name="SongTitleText"
                       Text="No song playing"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,14,0,0"/>

            <TextBlock x:Name="ChannelText"
                       Text="No Artist Found"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0"/>
            
            <Grid Margin="10,12,10,0">

                <TextBlock x:Name="CurrentTimeText"
                           Text="0:00"
                           Foreground="{DynamicResource LabelTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="22"
                        Margin="34,0,34,0"
                        PreviewMouseLeftButtonDown="ProgressSlider_MouseDown"
                        PreviewMouseLeftButtonUp="ProgressSlider_MouseUp">

                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">

                            <Grid VerticalAlignment="Center">

                                <Border Height="8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="4"/>

                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center">

                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                      Background="{DynamicResource ControlForegroundBrush}"
                                      BorderThickness="0"
                                      IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{DynamicResource ControlForegroundBrush}"
                                            Height="8"
                                            CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                      Background="{DynamicResource ControlFillBrush}"
                                      BorderThickness="0"
                                      IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{DynamicResource ControlFillBrush}"
                                            Height="8"
                                            CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="18"
                                               Height="18"
                                               Background="{DynamicResource ControlForegroundBrush}"
                                               BorderThickness="0">

                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">

                                                    <Ellipse Width="18"
                                                             Height="18"
                                                             Fill="{DynamicResource ControlForegroundBrush}"/>

                                                </ControlTemplate>
                                            </Thumb.Template>

                                        </Thumb>
                                    </Track.Thumb>

                                </Track>

                            </Grid>

                        </ControlTemplate>
                    </Slider.Template>

                </Slider>
                <TextBlock x:Name="DurationText"
                           Text="0:00"
                           Foreground="{DynamicResource LabelTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </Grid>
            
            <!-- Control Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="1,4,0,0">

                <Button x:Name="ShuffleToggleButton"
                        Content="🔀"
                        Background="{DynamicResource ControlFillBrush}"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Margin="8,0"
                        FontSize="15"
                        Width="36"
                        Height="36"
                        Click="Shuffle_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24"
                                    RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                                </Border.RenderTransform>

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1.12"
                                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1.12"
                                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button Content="⏮"
                        Background="{DynamicResource AlbumBackgroundBrush}"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Margin="0,0"
                        FontSize="20"
                        Width="48"
                        Height="48"
                        Click="PreviousButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24"
                                    RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform 
                                        ScaleX="1"
                                        ScaleY="1"/>
                                </Border.RenderTransform>

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1.12"
                                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1.12"
                                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonBorder"
                                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button x:Name="PlayButton"
                        Content="▶"       
                        FontSize="25"        
                        Width="58"       
                        Height="58"       
                        Margin="8,0"    
                        Click="PlayButton_Click"
                        Background="{DynamicResource AlbumBackgroundBrush}"
                        Foreground="{DynamicResource ControlForegroundBrush}">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="29"
                    RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1"
                                  ScaleY="1"/>
                                </Border.RenderTransform>

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                         Value="True">

                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button Content="⏭"
                        FontSize="20"
                        Width="48"
                        Height="48"
                        Click="NextButton_Click"
                        Background="{DynamicResource AlbumBackgroundBrush}"
                        Foreground="{DynamicResource ControlForegroundBrush}">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="24"
                                    RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                                </Border.RenderTransform>

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button x:Name="RepeatToggleButton"
                        Content="🔁"
                        Background="{DynamicResource MutedTextBrush}"
                        Foreground="{DynamicResource ControlForegroundBrush}"
                        Margin="8,0"
                        FontSize="15"
                        Width="36"
                        Height="36"
                        Click="Repeat_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="24"
                    RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                                </Border.RenderTransform>

                                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                         Value="True">

                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1.12"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>

                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleX"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                                <DoubleAnimation
                                    Storyboard.TargetName="ButtonBorder"
                                    Storyboard.TargetProperty="RenderTransform.ScaleY"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,6,0,0">

                <TextBlock x:Name="VolumeIcon"
               Text="🔊"
               Foreground="{DynamicResource PrimaryTextBrush}"
               FontSize="14"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                <Slider x:Name="VolumeSlider"
            Width="110"
            Minimum="0"
            Maximum="100"
            Value="100"
            Height="22"
            ValueChanged="VolumeSlider_ValueChanged">

                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">

                            <Grid VerticalAlignment="Center">

                                <Border Height="8"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="4"/>

                                <Track x:Name="PART_Track"
                           VerticalAlignment="Center">

                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                          Background="{DynamicResource ControlForegroundBrush}"
                                          BorderThickness="0"
                                          IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{DynamicResource ControlForegroundBrush}"
                                                Height="8"
                                                CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                          Background="{DynamicResource ControlFillBrush}"
                                          BorderThickness="0"
                                          IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{DynamicResource ControlFillBrush}"
                                                Height="8"
                                                CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="12"
                                               Height="18"
                                               Background="{DynamicResource ControlForegroundBrush}"
                                               BorderThickness="0">

                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Width="18"
                                                            Height="18"
                                                            Background="{DynamicResource ControlForegroundBrush}"
                                                            CornerRadius="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>

                                        </Thumb>
                                    </Track.Thumb>

                                </Track>

                            </Grid>

                        </ControlTemplate>
                    </Slider.Template>

                </Slider>

            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>