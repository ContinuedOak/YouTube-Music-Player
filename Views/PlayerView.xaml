<UserControl x:Class="OakMusic.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OakMusic">

    <Grid Margin="24,8,24,0">

        <StackPanel>

            <TextBlock Text="{Binding Source={x:Static local:AppInfo.Version}, StringFormat=v{0}}"
                       Foreground="#707070"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Border Width="220"
                    Height="220"
                    CornerRadius="14"
                    Background="#242424"
                    HorizontalAlignment="Center">

                <Image x:Name="AlbumCover"
                       Stretch="UniformToFill"/>

            </Border>

            <TextBlock x:Name="SongTitleText"
                       Text="No song playing"
                       Foreground="#F5F5F5"
                       FontSize="19"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,14,0,0"/>

            <TextBlock x:Name="ChannelText"
                       Text="YouTube Music"
                       Foreground="#858585"
                       FontSize="14"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0"/>

            <Grid Margin="10,12,10,0">

                <TextBlock x:Name="CurrentTimeText"
                           Text="0:00"
                           Foreground="#707070"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="22"
                        Margin="34,0,34,0"
                        PreviewMouseLeftButtonDown="ProgressSlider_MouseDown"
                        PreviewMouseLeftButtonUp="ProgressSlider_MouseUp">

                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">

                            <Grid VerticalAlignment="Center">

                                <Border Height="8"
                                        Background="#202020"
                                        CornerRadius="4"/>

                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center">

                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                      Background="White"
                                      BorderThickness="0"
                                      IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="White"
                                            Height="8"
                                            CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                      Background="#202020"
                                      BorderThickness="0"
                                      IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#202020"
                                            Height="8"
                                            CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="18"
                                               Height="18"
                                               Background="White"
                                               BorderThickness="0">

                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">

                                                    <Ellipse Width="18"
                                                             Height="18"
                                                             Fill="White"/>

                                                </ControlTemplate>
                                            </Thumb.Template>

                                        </Thumb>
                                    </Track.Thumb>

                                </Track>

                            </Grid>

                        </ControlTemplate>
                    </Slider.Template>

                </Slider>
                <TextBlock x:Name="DurationText"
                           Text="0:00"
                           Foreground="#707070"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0">

                <Button Content="⏮"
                        Background="#202020"
                        Foreground="White"
                        FontSize="20"
                        Width="48"
                        Height="48"
                        Click="PreviousButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="24">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button x:Name="PlayButton"
                        Content="▶"
                        FontSize="25"
                        Width="58"
                        Height="58"
                        Margin="8,0"
                        Click="PlayButton_Click"
                        Background="#202020"
                        Foreground="White">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="29">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button Content="⏭"
                        FontSize="20"
                        Width="48"
                        Height="48"
                        Click="NextButton_Click"
                        Background="#202020"
                        Foreground="White">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="24">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0">

                <TextBlock x:Name="VolumeIcon"
                           Text="🔊"
                           Foreground="#B8B8B8"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Slider x:Name="VolumeSlider"
                        Width="110"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        Height="22"
                        ValueChanged="VolumeSlider_ValueChanged">

                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">

                            <Grid VerticalAlignment="Center">

                                <Border Height="8"
                                        Background="#202020"
                                        CornerRadius="4"/>

                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center">

                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge"
                                          Background="White"
                                          BorderThickness="0"
                                          IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="White"
                                                Height="8"
                                                CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge"
                                          Background="#202020"
                                          BorderThickness="0"
                                          IsHitTestVisible="False">

                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#202020"
                                                Height="8"
                                                CornerRadius="4"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>

                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb Width="18"
                                               Height="18"
                                               Background="White"
                                               BorderThickness="0">

                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="White"/>
                                                </ControlTemplate>
                                            </Thumb.Template>

                                        </Thumb>
                                    </Track.Thumb>

                                </Track>

                            </Grid>

                        </ControlTemplate>
                    </Slider.Template>

                </Slider>

            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>