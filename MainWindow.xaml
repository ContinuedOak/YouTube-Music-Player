<Window x:Class="OakMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wvc="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:OakMusic.Views"
        mc:Ignorable="d"
        Title="YouTube Music"
        Width="380"
        Height="560"
        MinWidth="340"
        MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <Style TargetType="Button">

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource ButtonHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                 Value="True">

                                <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource ButtonHoverBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            CornerRadius="13">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>


            <!-- TITLE BAR -->

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="0"
                        Content="☰"
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Click="PlaylistButton_Click"/>


                <Button Grid.Column="1"
                        Content="⚙"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="16"
                        Click="SettingsButton_Click"/>


                <Button Grid.Column="2"
                        Content="YouTube Music"
                        Width="120"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Click="PlayerButton_Click"/>


                <Button Grid.Column="3"
                        Content="—"
                        Width="32"
                        Height="32"
                        Margin="-110,0,0,0"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Click="MinimizeButton_Click"/>


                <Button Grid.Column="4"
                        Content="⭕"
                        Width="32"
                        Height="32"
                        Margin="-50,0,0,0"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Bold"
                        Click="ResetWindowButton_Click"/>


                <Button Grid.Column="5"
                        Content="❌"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="0"
                        FontSize="10"
                        Click="CloseButton_Click"/>

            </Grid>


            <!-- VIEW HOST -->

            <Grid Grid.Row="1"
                  Margin="0,8,0,0">

                <views:PlayerView x:Name="PlayerView"
                                  Visibility="Visible"/>

                <views:SearchView x:Name="SearchView"
                                  Visibility="Collapsed"/>

                <views:PlaylistView x:Name="PlaylistView"
                                    Visibility="Collapsed"/>

                <views:SettingsView x:Name="SettingsView"
                                    Visibility="Collapsed"/>

            </Grid>


            <!-- SEARCH BAR -->

            <Grid Grid.Row="2"
                  Margin="20,8,20,10">

                <Border Background="{DynamicResource ControlFillBrush}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource ControlBoarderBrush}"
                        BorderThickness="1">

                    <Grid>

                        <TextBox x:Name="SearchTextBox"
                                 Margin="14,0,42,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 CaretBrush="{DynamicResource SearchBackgroundBrush}"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"
                                 KeyDown="SearchTextBox_KeyDown"/>


                        <TextBlock Text="Search"
                                   Margin="14,0,0,0"
                                   Foreground="{DynamicResource SearchTextBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Visible"
                                   x:Name="SearchPlaceholder"/>


                        <Button Content="⌕"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="{DynamicResource SearchTextBrush}"
                                BorderThickness="0"
                                FontSize="19"
                                Click="SearchButton_Click"/>

                    </Grid>

                </Border>

            </Grid>

            <!-- HIDDEN YOUTUBE PLAYER -->

            <wvc:WebView2 x:Name="YouTubePlayer"
                          Width="0"
                          Height="0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="-2000,0,0,0"
                          Visibility="Visible"
                          IsHitTestVisible="False"/>

        </Grid>

    </Border>

</Window>